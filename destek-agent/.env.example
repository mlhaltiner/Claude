# Bu dosyayı ".env" adıyla kopyalayıp doldurun. .env dosyasını kimseyle paylaşmayın.

# Anthropic API anahtarı (https://console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Telegram: BotFather'dan aldığınız bot token'ı
TELEGRAM_BOT_TOKEN=123456789:ABC...

# Bota komut verebilecek Telegram kullanıcı ID'leri (virgülle ayırın).
# Kendi ID'nizi öğrenmek için Telegram'da @userinfobot'a yazın.
IZINLI_KULLANICILAR=123456789

# MeshCentral bağlantısı
MESHCENTRAL_URL=wss://localhost:443
MESHCENTRAL_KULLANICI=admin
MESHCENTRAL_SIFRE=buraya-meshcentral-sifreniz
# meshctrl.js dosyasının yolu (MeshCentral'ı kurduğunuz klasörde)
MESHCTRL_YOLU=C:\meshcentral\node_modules\meshcentral\meshctrl.js

# Sadece bilgi okuyan komutlar (Get-..., ipconfig, ping gibi) onaysız çalışsın mı?
# "false" yaparsanız HER komut için Telegram'dan onay ister.
OKUMA_KOMUTLARI_ONAYSIZ=true
